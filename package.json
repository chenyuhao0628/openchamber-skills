{
  "name": "openchamber-skills",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "OpenChamber 技能开关：启停 OpenCode 技能、中文翻译和联动分组。",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.4.0"
    },
    "contributes": {
      "panel": {
        "id": "skills-manager",
        "name": "技能开关",
        "icon": "list-check-2",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {}
      },
      "capabilities": [
        "model"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.*"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.5.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "panel/",
    "service/",
    "README.md"
  ]
}
